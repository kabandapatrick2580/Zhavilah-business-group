# Sanity CMS — copy to .env.local and fill in from https://www.sanity.io/manage
# Both values are also required in the Vercel project settings.
#
# The site builds and runs without these: the blog simply shows its empty state
# until the Sanity project exists. See docs/CMS-IMPLEMENTATION.md, Phase 0.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Contact & subscribe forms — from https://resend.com/api-keys
# Server-only: no NEXT_PUBLIC_ prefix, so the key never reaches the browser.
#
# CONTACT_FROM_EMAIL must be on a domain verified in Resend. It is the envelope
# sender, not a reply target — replies go to whoever submitted the form.
# CONTACT_TO_EMAIL is the inbox that receives the enquiries.
#
# Without these the forms render and validate but return an error on submit,
# and the reason is logged server-side.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=website@zhavilahbusinessgroup.com
CONTACT_TO_EMAIL=info@zhavilahbusinessgroup.com

# Bot protection — https://dash.cloudflare.com → Turnstile → Add site.
# Free, and does not require the site to be hosted on Cloudflare.
#
# IMPORTANT: both forms FAIL OPEN when TURNSTILE_SECRET_KEY is unset — they keep
# working but the bot check is skipped, and a warning is logged on every submit.
# After deploying, confirm "[turnstile] ... DISABLED" is absent from the logs.
#
# Cloudflare's always-passes test pair, useful locally:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Training dashboard (/admin) — the single admin account, defined entirely here.
# There is no user table: this is one person editing one catalogue.
#
# All three must be set or the dashboard is switched off — the login page says
# so and every attempt fails. That is deliberate: an admin area that falls back
# to a blank password when the environment is missing is worse than one that is
# unreachable.
#
# ADMIN_SESSION_SECRET signs the session cookie. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every existing session, which is how you force a
# logout everywhere.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
